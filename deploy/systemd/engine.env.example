# This template is intentionally Paper-only. Do not store signer or Relayer
# credentials here.
TRADING_MODE=paper
POLYMARKET_ENGINE_SOCKET=/run/polymarket-btc-assistant/engine.sock
POLYMARKET_ENGINE_SOCKET_MODE=0660

# Internal strategy registry selection. Only registered strategies are accepted.
PAPER_TRADE_STRATEGY=TA_EDGE_V1_2_FOK

BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision

STREAM_HEALTH_CHECK_MS=5000
STREAM_RESTART_COOLDOWN_MS=15000
BINANCE_STREAM_STALE_MS=30000
POLYMARKET_LIVE_STREAM_STALE_MS=15000
TWAP_STREAM_STALE_MS=15000

# Append-only research events for strategy comparison and later calibration.
STRATEGY_RESEARCH_FILE=./logs/research_events.jsonl
STRATEGY_RESEARCH_INTERVAL_MS=15000

# Optional Polygon fallback endpoints:
# POLYGON_RPC_URL=https://polygon-rpc.com
# POLYGON_RPC_URLS=https://polygon-rpc.com,https://rpc.ankr.com/polygon
# POLYGON_WSS_URLS=wss://polygon-bor-rpc.publicnode.com
