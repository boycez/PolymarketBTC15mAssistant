[Unit]
Description=Polymarket BTC 15m Trading Engine
Documentation=https://github.com/boycez/polymarket-btc-assistant
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=polymarket-btc-assistant
Group=polymarket-btc-assistant
WorkingDirectory=/opt/polymarket-btc-assistant
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/polymarket-btc-assistant/engine.env
ExecStart=/usr/bin/env node /opt/polymarket-btc-assistant/src/engine.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

RuntimeDirectory=polymarket-btc-assistant
RuntimeDirectoryMode=0750
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/polymarket-btc-assistant/logs /run/polymarket-btc-assistant

StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-btc-assistant

[Install]
WantedBy=multi-user.target